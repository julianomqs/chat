{
  "name": "batepapo-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dev.mjs",
    "start:vite": "vite --host 0.0.0.0",
    "typecheck:dev": "tsc -p tsconfig.dev.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.dev.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -b && vite build",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "globals": "17.13.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "@types/node": "24.19.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
